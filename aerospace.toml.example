# Merge these top-level callbacks into ~/.config/aerospace/aerospace.toml.
# AeroSpace runs them on workspace and window focus changes. `nc -U` sends a
# short notification to the bar's Unix stream socket; set the same socket path
# in ~/.config/monobar/config.toml if you override the default.
on-focused-workspace-changed = ['exec-and-forget /bin/sh -c "printf workspace | nc -U $HOME/.config/monobar/events.sock"']
on-focus-changed = ['exec-and-forget /bin/sh -c "printf focus | nc -U $HOME/.config/monobar/events.sock"']
